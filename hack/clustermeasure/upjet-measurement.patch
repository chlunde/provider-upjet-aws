+// impliedTypeCache memoises the cty type implied by a resource's schema. The
+// type is a pure function of the schema, but CoreConfigSchema().ImpliedType()
+// rebuilds it on every Observe, Create and Update - and the value it produces is
+// then retained per managed resource. Measured on a provider holding 500 managed
+// resources: cty.Object and cty.ObjectVal accounted for 16.4 MiB, 31% of the
+// live heap, one copy per resource of a type there are only 25 distinct
+// instances of.
+var impliedTypeCache sync.Map
 
+func (n *terraformPluginSDKExternal) impliedType() cty.Type {
+	if os.Getenv("UPJET_CACHE_IMPLIED_TYPE") != "1" {
+		return n.config.TerraformResource.CoreConfigSchema().ImpliedType()
+	}
+	if v, ok := impliedTypeCache.Load(n.config.Name); ok {
+		return v.(cty.Type)
+	}
+	t := n.config.TerraformResource.CoreConfigSchema().ImpliedType()
+	impliedTypeCache.Store(n.config.Name, t)
+	return t
+}
